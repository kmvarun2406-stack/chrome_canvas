{
  "manifest_version": 3,
  "name": "Chroma Canvas",
  "version": "1.0.0",
  "description": "Rebuild Chrome your way: custom layouts, icon packs, live/video/image wallpapers, color themes, widgets and playful interactions.",
  "minimum_chrome_version": "114",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "favicon",
    "topSites"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "chrome_url_overrides": {
    "newtab": "src/newtab/newtab.html"
  },

  "action": {
    "default_title": "Chroma Canvas",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "src/newtab/newtab.html?settings=1",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/site-theme.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "commands": {
    "toggle-site-theme": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Toggle site theming on the current page"
    },
    "next-wallpaper": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Shuffle to the next wallpaper"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
